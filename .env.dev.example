# loops-server — Development Environment Variables
#
# Copy to .env.dev and adjust values.
# This file is loaded by docker-compose.dev.yml.
# DO NOT commit .env.dev — it is gitignored.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Loops
APP_ENV=local
APP_KEY=                              # generated by: docker compose -f docker-compose.dev.yml exec loops php artisan key:generate --show
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_URL=http://localhost:8086

# ── Loops Settings ────────────────────────────────────────────────────────────
LOOPS_ADMIN_DASHBOARD_AUTOUPDATE=true
LOOPS_REG_MIN_YEARS_OLD=16

# API Rate Limits (relaxed for dev)
LOOPS_API_RATE_LIMITS_ENABLED=false

# ── Database (dev container: loops_dev_db, port 3307 on host) ────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=loops_dev
DB_USERNAME=loops_admin
DB_PASSWORD=dev_password
DB_ROOT_PASSWORD=dev_root_password

# ── Redis (dev container: loops_dev_redis, port 6380 on host) ─────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=dev_redis_pass
REDIS_PORT=6379

# ── MinIO Object Storage (dev container: loops_dev_minio, port 9010 on host) ──
MINIO_ROOT_USER=loops_minio_admin
MINIO_ROOT_PASSWORD=dev_minio_pass

## S3 / MinIO
AWS_ACCESS_KEY_ID=loops_minio_admin
AWS_SECRET_ACCESS_KEY=dev_minio_pass
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=loops
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=http://localhost:9010/loops
AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_REQUIRED
AWS_RESPONSE_CHECKSUM_VALIDATION=WHEN_REQUIRED

# ── Mail / Mailpit (dev container: loops_dev_mailpit, port 8026 on host) ──────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_AUTO_TLS=false
MAIL_FROM_ADDRESS=loops@localhost
MAIL_FROM_NAME="${APP_NAME}"

# ── Queue / Horizon ────────────────────────────────────────────────────────────
QUEUE_CONNECTION=redis
HORIZON_PREFIX=horizon:

# ── Sessions ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=86400
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# ── Vite ──────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ── Misc ──────────────────────────────────────────────────────────────────────
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=10
