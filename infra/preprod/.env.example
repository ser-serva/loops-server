# loops-server — Pre-production environment
# Copy to .env and fill in all values before running docker compose up.
#
# Image tag to deploy — defaults to 'alpha' in compose.yaml.
# Override on the command line: IMAGE_TAG=v0.1.0-alpha.2 docker compose up -d
IMAGE_TAG=0.1.0-alpha.2

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Loops
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Set to http://localhost:8087 for local preprod, or your QA domain
APP_URL=http://localhost:8087
FRONTEND_URL=http://localhost:8087

LOOPS_ADMIN_DASHBOARD_AUTOUPDATE=true
LOOPS_REG_MIN_YEARS_OLD=16
LOOPS_API_RATE_LIMITS_ENABLED=false

LOG_CHANNEL=daily
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysqldb
DB_PORT=3306
DB_DATABASE=loops_preprod
DB_USERNAME=loops_admin
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# ── Queue / Cache ─────────────────────────────────────────────────────────────
QUEUE_CONNECTION=redis
CACHE_STORE=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3

HORIZON_PREFIX=horizon_preprod_

# ── MinIO (S3-compatible object storage) ──────────────────────────────────────
MINIO_ROOT_USER=loops_minio_admin
MINIO_ROOT_PASSWORD=

AWS_ACCESS_KEY_ID=${MINIO_ROOT_USER}
AWS_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=loops
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
# Media URL must be reachable from the browser — use host:port of MinIO S3 API
AWS_URL=http://localhost:9014/loops
AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_REQUIRED
AWS_RESPONSE_CHECKSUM_VALIDATION=WHEN_REQUIRED

# ── Mail (Mailpit catches all outbound email) ─────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@loops.preprod
MAIL_FROM_NAME="${APP_NAME}"

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=86400
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
